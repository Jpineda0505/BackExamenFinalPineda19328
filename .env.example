# Entorno
NODE_ENV=development
PORT=3000

# Driver de base de datos: oracledb | mysql2
DB_CLIENT=oracledb

# Oracle (modo Thin, sin Instant Client)
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_CONNECT=localhost:1521/FREEPDB1

# MySQL 8 (comentar si se usa Oracle)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=nombre_base_datos

# CORS — separar varios origenes con coma
CORS_ORIGIN=http://localhost:5173
